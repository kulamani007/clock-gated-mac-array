*.str
webtalk*
vivado_pid*

# ---------------------------------------------------------------------------
# Large regenerable tool outputs. Everything here is reproduced by the scripts
# in synth/ ; committing it would add ~25 MB of undiffable binaries.
#   checkpoints  -> run_build.bat / run_build2.bat
#   SAIF         -> run_power.bat / run_power_post.bat
#   netlists     -> gen_netlist.tcl
# ---------------------------------------------------------------------------
*.dcp
*.saif
synth/dcp/
synth/saif/
synth/saifp/
synth/netlist/

# ---------------------------------------------------------------------------
# Per-run generated files and tool logs
# ---------------------------------------------------------------------------
synth/cfg_*.v
synth/cfgr_*.v
synth/log_*.txt
synth/*_stage.txt
synth/saif_*.tcl
synth/probe*.txt
synth/probe*.bat
synth/test_xvlog.*
synth/dspreg*.txt
synth/netmatch.txt
synth/pxerr.txt
synth/dsp_err.txt
synth/ir_path.txt
synth/repo_survey.ps1
synth/fill_stage.txt
synth/post_stage.txt
synth/power_stage.txt
synth/build_stage.txt
synth/build2_stage.txt
synth/retry_stage.txt

