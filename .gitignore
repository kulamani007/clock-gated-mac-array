paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls
paper/pg-*.png
paper/pp-*.png
paper/p2-*.png
paper/q-*.png
paper/r-*.png
paper/s-*.png
paper/f1-*.png
paper/b.log
paper/build.log

